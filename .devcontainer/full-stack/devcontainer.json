{
  "name": "Payt Full Stack",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "backend",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "privileged": true,
  "forwardPorts": [3000, 5000, 5001],
  "portsAttributes": {
    "3000": { "label": "Rails backend", "onAutoForward": "silent" },
    "5000": { "label": "Frontend", "onAutoForward": "openBrowser" },
    "5001": { "label": "Debtor portal", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/full-stack/postCreate.sh",
  "postStartCommand": "bash .devcontainer/full-stack/postStart.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
